NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Tokyo

WEB_PORT=3000
API_HOST=0.0.0.0
API_PORT=3001
WORKER_HEALTH_PORT=3002
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000

DATABASE_URL=postgresql://chaincopy:chaincopy@localhost:5432/chaincopy?schema=public
REDIS_URL=redis://localhost:6379

AUTH_SECRET=replace-with-a-random-value-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
ALLOWED_ADMIN_EMAIL=owner@example.com

INTERNAL_API_SECRET=replace-with-a-random-value-at-least-32-characters
CRON_SECRET=replace-with-a-different-random-value-at-least-32-characters

# Phase 2 Hyperliquid read-only public data.
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_NETWORK=mainnet
HYPERLIQUID_HTTP_TIMEOUT_MS=10000
HYPERLIQUID_SYNC_INTERVAL_MS=60000

# Phase 3 Hyperliquid market-wide address discovery.
HYPERLIQUID_DISCOVERY_ENABLED=false
HYPERLIQUID_DISCOVERY_MODE=MAJOR
HYPERLIQUID_DISCOVERY_PRIORITY_COINS=BTC,ETH,SOL,HYPE,SUI
HYPERLIQUID_DISCOVERY_MIN_TRADES=10
HYPERLIQUID_DISCOVERY_MIN_NOTIONAL_USD=10000
HYPERLIQUID_DISCOVERY_RECENT_HOURS=24
HYPERLIQUID_DISCOVERY_ENRICHMENT_CONCURRENCY=2
HYPERLIQUID_DISCOVERY_MIN_ENRICHMENT_INTERVAL_MIN=1440
HYPERLIQUID_DISCOVERY_SCHEDULER_INTERVAL_MS=10000
HYPERLIQUID_DISCOVERY_MAX_RECONNECT_ATTEMPTS=12
HYPERLIQUID_DISCOVERY_KNOWN_SYSTEM_ADDRESSES=0x0000000000000000000000000000000000000000
HYPERLIQUID_API_WEIGHT_PER_MINUTE=1200
# Optional for `pnpm --filter @chaincopy/worker verify:phase2`.
HYPERLIQUID_VERIFICATION_ADDRESS=0x831ea8a4a4d7ea2657ba48f8c074d69bdaece05c

# Later-phase placeholders.
SUI_GRAPHQL_URL=https://sui-mainnet.mystenlabs.com/graphql
SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443
SUI_NETWORK=mainnet
CETUS_PACKAGE_IDS=
CETUS_POOL_ALLOWLIST=

# Phase 7+ placeholders. Phase 1 does not send email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
RESEND_WEBHOOK_SECRET=

# Optional future services.
OPENAI_API_KEY=
OPENAI_MODEL=
SENTRY_DSN=
