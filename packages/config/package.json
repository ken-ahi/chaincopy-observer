{
  "name": "@chaincopy/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "import": "./dist/logger.js",
      "default": "./dist/logger.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
