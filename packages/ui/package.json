{
  "name": "@chaincopy/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./badge": {
      "types": "./src/components/badge.tsx",
      "import": "./dist/components/badge.js",
      "default": "./dist/components/badge.js"
    },
    "./button": {
      "types": "./src/components/button.tsx",
      "import": "./dist/components/button.js",
      "default": "./dist/components/button.js"
    },
    "./card": {
      "types": "./src/components/card.tsx",
      "import": "./dist/components/card.js",
      "default": "./dist/components/card.js"
    },
    "./progress": {
      "types": "./src/components/progress.tsx",
      "import": "./dist/components/progress.js",
      "default": "./dist/components/progress.js"
    },
    "./utils": {
      "types": "./src/lib/utils.ts",
      "import": "./dist/lib/utils.js",
      "default": "./dist/lib/utils.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.8",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
