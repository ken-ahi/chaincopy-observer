  /// 更新日時
  updatedAt               DateTime                       @updatedAt @map("updated_at")

  @@index([walletAddressId, status, requestedAt], map: "metric_runs_wallet_status_requested_idx")
  @@index([walletAddressId, calculationVersion, inputFingerprint], map: "metric_runs_input_idx")
  @@map("metric_calculation_runs")
}

/// 日次純資産額（NAV）
model DailyNav {
  /// ID
  id                  String                         @id @default(cuid())
  /// ウォレットアドレスID
  walletAddressId     String                         @map("wallet_address_id")
  walletAddress       WalletAddress                  @relation(fields: [walletAddressId], references: [id], onDelete: Cascade)
  /// 計算実行ID
  calculationRunId    String                         @map("calculation_run_id")
  calculationRun      MetricCalculationRun           @relation(fields: [calculationRunId], references: [id], onDelete: Cascade)
  /// NAV対象日
  date                DateTime                       @db.Date
  /// 日次純資産額（NAV）
  nav                 Decimal                        @db.Decimal(38, 18)
  /// 現金残高
  cashBalance         Decimal?                       @map("cash_balance") @db.Decimal(38, 18)
  /// 含み損益
  unrealizedPnl       Decimal?                       @map("unrealized_pnl") @db.Decimal(38, 18)
  /// 実現損益
  realizedPnl         Decimal?                       @map("realized_pnl") @db.Decimal(38, 18)
  /// 資金調達料（Funding）
  funding             Decimal?                       @db.Decimal(38, 18)
  /// 手数料合計
  fees                Decimal?                       @db.Decimal(38, 18)
  /// 外部キャッシュフロー
  externalCashFlow    Decimal?                       @map("external_cash_flow") @db.Decimal(38, 18)
  /// 精度区分
  precision           PerformancePrecision
  /// 履歴完全性
  historyCompleteness PerformanceHistoryCompleteness @map("history_completeness")
  /// 登録日時
  createdAt           DateTime                       @default(now()) @map("created_at")

  @@unique([calculationRunId, date], map: "daily_navs_run_date_key")
  @@index([walletAddressId, date], map: "daily_navs_wallet_date_idx")
  @@map("daily_navs")
}

/// ポジションサイクル（Position Cycle）
model PositionCycle {
  /// ID
  id                String               @id @default(cuid())
  /// ウォレットアドレスID
  walletAddressId   String               @map("wallet_address_id")
  walletAddress     WalletAddress        @relation(fields: [walletAddressId], references: [id], onDelete: Cascade)
  /// 計算実行ID
  calculationRunId  String               @map("calculation_run_id")
  calculationRun    MetricCalculationRun @relation(fields: [calculationRunId], references: [id], onDelete: Cascade)
  /// 銘柄
  coin              String
  /// 売買方向
  side              PositionSide
  /// 開始日時
  openedAt          DateTime             @map("opened_at")
  /// 終了日時
  closedAt          DateTime?            @map("closed_at")
  /// 平均エントリー価格
  averageEntryPrice Decimal              @map("average_entry_price") @db.Decimal(38, 18)
  /// 平均決済価格
  averageExitPrice  Decimal?             @map("average_exit_price") @db.Decimal(38, 18)
  /// エントリー数量
  entryQuantity     Decimal              @map("entry_quantity") @db.Decimal(38, 18)
  /// 決済数量
  exitQuantity      Decimal              @map("exit_quantity") @db.Decimal(38, 18)
  /// 総実現損益
  grossRealizedPnl  Decimal              @map("gross_realized_pnl") @db.Decimal(38, 18)
  /// 手数料合計
  fees              Decimal              @db.Decimal(38, 18)
  /// 資金調達料（Funding）
  funding           Decimal              @db.Decimal(38, 18)
  /// 純実現損益
  netRealizedPnl    Decimal              @map("net_realized_pnl") @db.Decimal(38, 18)
  /// Fill件数
  fillCount         Int                  @map("fill_count")
  /// ステータス
  status            PositionCycleStatus
  /// 入力フィンガープリント
  inputFingerprint  String               @map("input_fingerprint")
  /// 登録日時
  createdAt         DateTime             @default(now()) @map("created_at")

  @@unique([calculationRunId, inputFingerprint], map: "position_cycles_run_input_key")
  @@index([walletAddressId, openedAt], map: "position_cycles_wallet_opened_idx")
  @@map("position_cycles")
}

/// アドレス運用指標
model AddressPerformanceMetric {
  /// ID
  id               String                  @id @default(cuid())
  /// ウォレットアドレスID
  walletAddressId  String                  @map("wallet_address_id")
  walletAddress    WalletAddress           @relation(fields: [walletAddressId], references: [id], onDelete: Cascade)
  /// 計算実行ID
  calculationRunId String                  @map("calculation_run_id")
  calculationRun   MetricCalculationRun    @relation(fields: [calculationRunId], references: [id], onDelete: Cascade)
  /// 指標キー
  metricKey        String                  @map("metric_key")
  /// 指標値（Decimal）
  metricValue      Decimal                 @map("metric_value") @db.Decimal(38, 18)
  /// 精度区分
  precision        PerformancePrecision
  /// ステータス
  status           PerformanceMetricStatus
  /// 警告コード
  warningCodes     String[]                @default([]) @map("warning_codes")
  /// 計算開始日時
  calculationFrom  DateTime                @map("calculation_from")
  /// 計算終了日時
  calculationTo    DateTime                @map("calculation_to")
  /// 指標バージョン
  metricVersion    String                  @map("metric_version")
  /// 登録日時
  createdAt        DateTime                @default(now()) @map("created_at")

  @@unique([calculationRunId, metricKey], map: "performance_metrics_run_key")
  @@index([walletAddressId, metricKey, calculationTo], map: "performance_metrics_wallet_key_to_idx")
  @@map("address_performance_metrics")
}

/// 参考ウォレット選定設定
model WalletSelectionSettings {
  /// ID
  id                          String              @id @default(cuid())
  /// データソースID
  sourceId                    String              @unique @map("source_id")
  source                      DataSource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// 現在有効な選定実行ID
  currentSelectionRunId       String?             @unique(map: "wallet_selection_settings_current_run_key") @map("current_selection_run_id")
  currentSelectionRun         WalletSelectionRun? @relation("CurrentWalletSelectionRun", fields: [currentSelectionRunId], references: [id], onDelete: SetNull, map: "wallet_selection_settings_current_run_id_fkey")
  /// 自動選定する最大件数
  maxAutoSelected             Int                 @default(100) @map("max_auto_selected")
  /// 最低評価期間（日）
  minimumEvaluationDays       Int                 @default(90) @map("minimum_evaluation_days")
  /// 最低完了取引数
  minimumTrustedClosedCycles  Int                 @default(20) @map("minimum_trusted_closed_cycles")
  /// 最低年率換算収益率
  minimumAnnualizedReturn     Decimal             @default(0) @map("minimum_annualized_return") @db.Decimal(38, 18)
  /// 最大下落の上限
  maximumDrawdown             Decimal             @default(0.5) @map("maximum_drawdown") @db.Decimal(38, 18)
  /// 大勝ち依存の上限
  maximumTopTradeContribution Decimal             @default(0.75) @map("maximum_top_trade_contribution") @db.Decimal(38, 18)
  /// データ更新の許容時間
  maximumDataAgeHours         Int                 @default(24) @map("maximum_data_age_hours")
  /// 登録日時
  createdAt                   DateTime            @default(now()) @map("created_at")
  /// 更新日時
  updatedAt                   DateTime            @updatedAt @map("updated_at")

  @@map("wallet_selection_settings")
}

/// 参考ウォレット選定実行
model WalletSelectionRun {
  /// ID
  id                      String                   @id @default(cuid())
  /// データソースID
  sourceId                String                   @map("source_id")
  source                  DataSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// 選定ポリシーバージョン
  policyVersion           String                   @map("policy_version")
  /// 入力フィンガープリント
  inputFingerprint        String                   @map("input_fingerprint")
  /// 選定設定スナップショット
  policySnapshot          Json                     @map("policy_snapshot")
  /// 評価日時
  evaluatedAt             DateTime                 @map("evaluated_at")
  /// 評価対象件数
  universeCount           Int                      @map("universe_count")
  /// 参考対象件数
  selectedCount           Int                      @map("selected_count")
  /// 候補件数
  qualifiedCount          Int                      @map("qualified_count")
  /// 要確認件数
  reviewCount             Int                      @map("review_count")
  /// 対象外件数
  excludedCount           Int                      @map("excluded_count")
  results                 WalletSelectionResult[]
  currentForSettings      WalletSelectionSettings? @relation("CurrentWalletSelectionRun")
  behaviorSelectionScopes BehaviorSelectionScope[]
  /// 登録日時
  createdAt               DateTime                 @default(now()) @map("created_at")

  @@unique([sourceId, policyVersion, inputFingerprint], map: "wallet_selection_runs_input_key")
  @@index([sourceId, evaluatedAt], map: "wallet_selection_runs_source_evaluated_idx")
  @@map("wallet_selection_runs")
}

/// 参考ウォレット選定結果
model WalletSelectionResult {
  /// ID
  id               String                         @id @default(cuid())
  /// 選定実行ID
  selectionRunId   String                         @map("selection_run_id")
  selectionRun     WalletSelectionRun             @relation(fields: [selectionRunId], references: [id], onDelete: Cascade)
  /// ウォレットアドレスID
  walletAddressId  String                         @map("wallet_address_id")
  walletAddress    WalletAddress                  @relation(fields: [walletAddressId], references: [id], onDelete: Cascade)
  /// Performance計算実行ID
  performanceRunId String?                        @map("performance_run_id")
  performanceRun   MetricCalculationRun?          @relation(fields: [performanceRunId], references: [id], onDelete: SetNull)
  /// 自動判定ステータス
  automaticStatus  WalletSelectionAutomaticStatus @map("automatic_status")
  /// 収益性順位
  rank             Int?
  /// 判定理由コード
  reasonCodes      String[]                       @default([]) @map("reason_codes")
  /// 登録日時
  createdAt        DateTime                       @default(now()) @map("created_at")

  @@unique([selectionRunId, walletAddressId], map: "wallet_selection_results_run_wallet_key")
  @@index([walletAddressId, createdAt], map: "wallet_selection_results_wallet_created_idx")
  @@map("wallet_selection_results")
}

/// 参考ウォレット手動指定
model WalletSelectionOverride {
  /// ID
  id              String                          @id @default(cuid())
  /// ウォレットアドレスID
  walletAddressId String                          @unique @map("wallet_address_id")
  walletAddress   WalletAddress                   @relation(fields: [walletAddressId], references: [id], onDelete: Cascade)
  /// 手動指定
  decision        WalletSelectionOverrideDecision @default(AUTO)
  /// 所有者メモ
  note            String?                         @db.Text
  /// 登録日時
  createdAt       DateTime                        @default(now()) @map("created_at")
  /// 更新日時
  updatedAt       DateTime                        @updatedAt @map("updated_at")

  @@map("wallet_selection_overrides")
}

/// システムアラート
model SystemAlert {
  /// ID
  id          String        @id @default(cuid())
  /// フィンガープリント
  fingerprint String        @unique
  /// 重要度
  severity    AlertSeverity
  /// ステータス
  status      AlertStatus   @default(OPEN)
  /// タイトル
  title       String
  /// メッセージ
  message     String        @db.Text
  /// データソースID
  sourceId    String?       @map("source_id")
  source      DataSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  /// 開始日時
  openedAt    DateTime      @default(now()) @map("opened_at")
  /// 解消日時
  resolvedAt  DateTime?     @map("resolved_at")
  /// 登録日時
  createdAt   DateTime      @default(now()) @map("created_at")
  /// 更新日時
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status, severity])
  @@index([sourceId])
  @@map("system_alerts")
}

/// 監査ログ
model AuditLog {
  /// ID
  id           String   @id @default(cuid())
  /// 操作ユーザーID
  actorUserId  String?  @map("actor_user_id")
  actorUser    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// 操作
  action       String
  /// リソース種別
  resourceType String   @map("resource_type")
  /// リソースID
  resourceId   String?  @map("resource_id")
  /// IPアドレス
  ipAddress    String?  @map("ip_address")
  /// ユーザーエージェント
  userAgent    String?  @map("user_agent") @db.Text
  /// メタデータ
  metadata     Json?
  /// 登録日時
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

/// behavior-v1 normalization execution provenance.
model BehaviorNormalizationRun {
  id                String                        @id @default(cuid())
  behaviorVersion   String                        @map("behavior_version")
  walletAddressId   String                        @map("wallet_address_id")
  walletAddress     WalletAddress                 @relation(fields: [walletAddressId], references: [id], onDelete: Restrict)
  sourceId          String                        @map("source_id")
  source            DataSource                    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  coin              String
  calculationFrom   DateTime                      @map("calculation_from")
  calculationTo     DateTime                      @map("calculation_to")
  inputFingerprint  String                        @map("input_fingerprint")
  status            BehaviorNormalizationStatus   @default(PENDING)
  startedAt         DateTime?                     @map("started_at")
  completedAt       DateTime?                     @map("completed_at")
  errorCode         String?                       @map("error_code")
  errorMessage      String?                       @map("error_message") @db.Text
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")
  events            SelectedWalletBehaviorEvent[]
  selectionScopes   BehaviorSelectionScope[]
  cursors           BehaviorNormalizationCursor[]
  dataQualityIssues BehaviorDataQualityIssue[]

  @@unique([behaviorVersion, walletAddressId, coin, calculationFrom, calculationTo, inputFingerprint], map: "behavior_runs_input_key")
  @@index([walletAddressId, coin, behaviorVersion, status], map: "behavior_runs_wallet_coin_status_idx")
  @@map("behavior_normalization_runs")
}

/// Stable behavior event identity. Selection and performance provenance deliberately live elsewhere.
model SelectedWalletBehaviorEvent {
  id                 String                   @id @default(cuid())
  fingerprint        String                   @unique(map: "behavior_events_fingerprint_key")
  behaviorVersion    String                   @map("behavior_version")
  eventType          BehaviorEventType        @map("event_type")
  direction          BehaviorDirection
  walletAddressId    String                   @map("wallet_address_id")
  walletAddress      WalletAddress            @relation(fields: [walletAddressId], references: [id], onDelete: Restrict)
  sourceId           String                   @map("source_id")
  source             DataSource               @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  coin               String
  occurredAt         DateTime                 @map("occurred_at")
  beforePosition     Decimal                  @map("before_position") @db.Decimal(38, 18)
  afterPosition      Decimal                  @map("after_position") @db.Decimal(38, 18)
  quantityDelta      Decimal                  @map("quantity_delta") @db.Decimal(38, 18)
  notionalDeltaUsd   Decimal                  @map("notional_delta_usd") @db.Decimal(38, 18)
  sourceType         String                   @default("NORMALIZED_TRADE") @map("source_type")
  sourceEventId      String                   @map("source_event_id")
  sourceEvent        NormalizedTrade          @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  sourceTradeId      String?                  @map("source_trade_id")
  sourceOrdinal      Int                      @map("source_ordinal")
  sourcePrice        Decimal                  @map("source_price") @db.Decimal(38, 18)
  sourceQuantity     Decimal                  @map("source_quantity") @db.Decimal(38, 18)
  normalizationRunId String                   @map("normalization_run_id")
  normalizationRun   BehaviorNormalizationRun @relation(fields: [normalizationRunId], references: [id], onDelete: Restrict)
  createdAt          DateTime                 @default(now()) @map("created_at")

  @@unique([behaviorVersion, sourceEventId, sourceOrdinal], map: "behavior_events_source_ordinal_key")
  @@index([walletAddressId, coin, occurredAt, id], map: "behavior_events_wallet_coin_time_idx")
  @@index([coin, occurredAt, id], map: "behavior_events_coin_time_idx")
  @@index([normalizationRunId], map: "behavior_events_run_idx")
  @@map("selected_wallet_behavior_events")
}

/// Why a wallet belonged to a behavior normalization execution; not event identity.
model BehaviorSelectionScope {
  id                         String                   @id @default(cuid())
  selectionRunId             String                   @map("selection_run_id")
  selectionRun               WalletSelectionRun       @relation(fields: [selectionRunId], references: [id], onDelete: Restrict)
  walletAddressId            String                   @map("wallet_address_id")
  walletAddress              WalletAddress            @relation(fields: [walletAddressId], references: [id], onDelete: Restrict)
  performanceRunId           String?                  @map("performance_run_id")
  performanceRun             MetricCalculationRun?    @relation(fields: [performanceRunId], references: [id], onDelete: Restrict)
  behaviorNormalizationRunId String                   @map("behavior_normalization_run_id")
  behaviorNormalizationRun   BehaviorNormalizationRun @relation(fields: [behaviorNormalizationRunId], references: [id], onDelete: Restrict)
  evaluatedAt                DateTime                 @map("evaluated_at")
  processedAt                DateTime                 @map("processed_at")
  createdAt                  DateTime                 @default(now()) @map("created_at")

  @@unique([selectionRunId, walletAddressId, behaviorNormalizationRunId], map: "behavior_selection_scopes_key")
  @@index([walletAddressId, selectionRunId], map: "behavior_selection_scopes_wallet_run_idx")
  @@index([behaviorNormalizationRunId], map: "behavior_selection_scopes_normalization_run_idx")
  @@map("behavior_selection_scopes")
}

/// Resume position is committed only after a complete timestamp group.
model BehaviorNormalizationCursor {
  id                     String                    @id @default(cuid())
  walletAddressId        String                    @map("wallet_address_id")
  walletAddress          WalletAddress             @relation(fields: [walletAddressId], references: [id], onDelete: Restrict)
  coin                   String
  behaviorVersion        String                    @map("behavior_version")
  lastCompletedTimestamp DateTime?                 @map("last_completed_timestamp")
  boundaryAfterPosition  Decimal?                  @map("boundary_after_position") @db.Decimal(38, 18)
  lastSourceEventId      String?                   @map("last_source_event_id")
  normalizationRunId     String?                   @map("normalization_run_id")
  normalizationRun       BehaviorNormalizationRun? @relation(fields: [normalizationRunId], references: [id], onDelete: Restrict)
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  @@unique([walletAddressId, coin, behaviorVersion], map: "behavior_cursors_wallet_coin_version_key")
  @@index([normalizationRunId], map: "behavior_cursors_run_idx")
  @@map("behavior_normalization_cursors")
}

/// Behavior-specific, idempotent and re-evaluable data-quality lifecycle.
model BehaviorDataQualityIssue {
  id                 String                    @id @default(cuid())
  fingerprint        String                    @unique(map: "behavior_dq_fingerprint_key")
  reason             BehaviorDataQualityReason
  status             DataQualityIssueStatus    @default(OPEN)
  behaviorVersion    String                    @map("behavior_version")
  walletAddressId    String                    @map("wallet_address_id")
  walletAddress      WalletAddress             @relation(fields: [walletAddressId], references: [id], onDelete: Restrict)
  sourceId           String                    @map("source_id")
  source             DataSource                @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  coin               String
  sourceEventId      String?                   @map("source_event_id")
  sourceEvent        NormalizedTrade?          @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  sourceGroupAt      DateTime?                 @map("source_group_at")
  normalizationRunId String                    @map("normalization_run_id")
  normalizationRun   BehaviorNormalizationRun  @relation(fields: [normalizationRunId], references: [id], onDelete: Restrict)
  detail             String                    @db.Text
  firstObservedAt    DateTime                  @default(now()) @map("first_observed_at")
  lastObservedAt     DateTime                  @default(now()) @map("last_observed_at")
  resolvedAt         DateTime?                 @map("resolved_at")
  reevaluationCount  Int                       @default(0) @map("reevaluation_count")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@index([walletAddressId, coin, status, reason], map: "behavior_dq_wallet_coin_status_idx")
  @@index([normalizationRunId, status], map: "behavior_dq_run_status_idx")
  @@map("behavior_data_quality_issues")
}
