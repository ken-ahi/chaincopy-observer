generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataSourceKind {
  HYPERLIQUID
  SUI
  CETUS
  SYSTEM
}

enum OperationalStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum SyncCursorStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
  GAP_DETECTED
}

enum DataQualityIssueStatus {
  OPEN
  RESOLVED
}

enum BehaviorNormalizationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
}

enum BehaviorEventType {
  POSITION_OPEN
  POSITION_INCREASE
  POSITION_REDUCE
  POSITION_CLOSE
}

enum BehaviorDirection {
  LONG
  SHORT
}

enum BehaviorDataQualityReason {
  MISSING_BOUNDARY
  ORDERING_AMBIGUOUS
  INVALID_DECIMAL
  SOURCE_INCONSISTENT
  IMPOSSIBLE_TRANSITION
  HISTORY_GAP
  UNSUPPORTED_QUOTE
  INCOMPLETE_TIMESTAMP_GROUP
}

enum EventTransport {
  HTTP
  WEBSOCKET
}

enum TradeSide {
  BUY
  SELL
}

enum PositionSide {
  LONG
  SHORT
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum CandidateEnrichmentStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RATE_LIMITED
}

enum CandidateFilterStatus {
  PENDING
  LIGHT_ELIGIBLE
  INSUFFICIENT_HISTORY
  ELIGIBLE
  EXCLUDED
  PROMOTED
}

enum CandidateHistoryCompleteness {
  UNKNOWN
  COMPLETE
  PARTIAL
  INSUFFICIENT
}

enum CandidateTradeRole {
  BUYER
  SELLER
  SELF
}

enum CandidateLiquidityRole {
  MAKER
  TAKER
}

enum CandidateActivityPeriod {
  DAY
  HOUR
}

enum DiscoveryMode {
  MAJOR
  ALL
}

enum DiscoveryConnectionStatus {
  STOPPED
  STARTING
  CONNECTED
  RECONNECTING
  DEGRADED
}

enum MetricCalculationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  INSUFFICIENT_DATA
  FAILED
}

enum PerformanceHistoryCompleteness {
  COMPLETE
  PARTIAL
  TRUNCATED
  GAP_DETECTED
  INSUFFICIENT_HISTORY
}

enum PerformancePrecision {
  EXACT
  DERIVED
  ESTIMATED
  UNAVAILABLE
}

enum PerformanceMetricStatus {
  AVAILABLE
  REFERENCE_ONLY
}

enum PositionCycleStatus {
  OPEN
  CLOSED
}

enum WalletSelectionAutomaticStatus {
  SELECTED
  QUALIFIED
  REVIEW
  EXCLUDED
}

enum WalletSelectionOverrideDecision {
  AUTO
  INCLUDE
  EXCLUDE
}

/// アプリ利用者
model User {
  /// ID
  id              String          @id @default(cuid())
  /// 利用者名
  name            String?
  /// メールアドレス
  email           String?         @unique
  /// メール確認日時
  emailVerified   DateTime?       @map("email_verified")
  /// 画像URL
  image           String?
  /// 登録日時
  createdAt       DateTime        @default(now()) @map("created_at")
  /// 更新日時
  updatedAt       DateTime        @updatedAt @map("updated_at")
  accounts        Account[]
  sessions        Session[]
  auditLogs       AuditLog[]
  walletAddresses WalletAddress[]

  @@map("users")
}

/// 外部認証アカウント
model Account {
  /// ID
  id                 String  @id @default(cuid())
  /// ユーザーID
  userId             String  @map("user_id")
  /// アカウント種別
  type               String
  /// 認証プロバイダー
  provider           String
  /// プロバイダーアカウントID
  providerAccountId  String  @map("provider_account_id")
  /// リフレッシュトークン
  refresh_token      String? @db.Text
  /// アクセストークン
  access_token       String? @db.Text
  /// 有効期限（UNIX秒）
  expires_at         Int?
  /// トークン種別
  token_type         String?
  /// 認可スコープ
  scope              String?
  /// IDトークン
  id_token           String? @db.Text
  /// セッション状態
  session_state      String?
  /// OAuthトークンシークレット
  oauth_token_secret String? @db.Text
  /// OAuthトークン
  oauth_token        String? @db.Text
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// 認証セッション
model Session {
  /// ID
  id           String   @id @default(cuid())
  /// セッショントークン
  sessionToken String   @unique @map("session_token")
  /// ユーザーID
  userId       String   @map("user_id")
  /// 有効期限
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// 認証確認トークン
model VerificationToken {
  /// 識別子
  identifier String
  /// 確認トークン
  token      String
  /// 有効期限
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// データソース
model DataSource {
  /// ID
  id                           String                        @id @default(cuid())
  /// データソースキー
  key                          String                        @unique
  /// データソース名
  name                         String
  /// データソース種別
  kind                         DataSourceKind
  /// 有効フラグ
  enabled                      Boolean                       @default(false)
  /// ステータス
  status                       OperationalStatus             @default(UNKNOWN)
  /// 最終成功日時
  lastSuccessAt                DateTime?                     @map("last_success_at")
  /// 最終失敗日時
  lastFailureAt                DateTime?                     @map("last_failure_at")
  /// ステータスメッセージ
  statusMessage                String?                       @map("status_message")
  /// 登録日時
  createdAt                    DateTime                      @default(now()) @map("created_at")
  /// 更新日時
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  syncJobs                     SyncJob[]
  systemAlerts                 SystemAlert[]
  walletAddresses              WalletAddress[]
  rawEvents                    RawEvent[]
  normalizedTrades             NormalizedTrade[]
  fundingPayments              FundingPayment[]
  cashFlows                    CashFlow[]
  perpPositions                PerpPosition[]
  perpPositionEvents           PerpPositionEvent[]
  portfolioSnapshots           PortfolioSnapshot[]
  spotBalanceSnapshots         SpotBalanceSnapshot[]
  orderHistory                 OrderHistory[]
  syncCursors                  SyncCursor[]
  dataQualityIssues            DataQualityIssue[]
  addressCandidates            AddressCandidate[]
  discoveryTrades              DiscoveryTrade[]
  discoverySettings            DiscoverySettings?
  discoveryStats               DiscoveryStats?
  discoveryCursors             DiscoveryCursor[]
  discoveryIssues              DiscoveryDataQualityIssue[]
  walletSelectionSettings      WalletSelectionSettings?
  walletSelectionRuns          WalletSelectionRun[]
  behaviorNormalizationRuns    BehaviorNormalizationRun[]
  selectedWalletBehaviorEvents SelectedWalletBehaviorEvent[]
  behaviorDataQualityIssues    BehaviorDataQualityIssue[]

  @@map("data_sources")
}

/// 同期ジョブ（Sync Job）
model SyncJob {
  /// ID
  id                 String            @id @default(cuid())
  /// 冪等キー
  idempotencyKey     String            @unique @map("idempotency_key")
  /// Queue名
  queueName          String            @map("queue_name")
  /// ジョブ名
  jobName            String            @map("job_name")
  /// QueueジョブID
  queueJobId         String?           @map("queue_job_id")
  /// ステータス
  status             SyncJobStatus     @default(QUEUED)
  /// 試行回数
  attempt            Int               @default(0)
  /// 開始日時
  startedAt          DateTime?         @map("started_at")
  /// 終了日時
  finishedAt         DateTime?         @map("finished_at")
  /// エラーメッセージ
  errorMessage       String?           @map("error_message") @db.Text
  /// メタデータ
  metadata           Json?
  /// データソースID
  sourceId           String?           @map("source_id")
  source             DataSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  /// ウォレットアドレスID
  walletAddressId    String?           @map("wallet_address_id")
  walletAddress      WalletAddress?    @relation(fields: [walletAddressId], references: [id], onDelete: Cascade)
  /// アドレス候補ID
  addressCandidateId String?           @map("address_candidate_id")
  addressCandidate   AddressCandidate? @relation(fields: [addressCandidateId], references: [id], onDelete: Cascade)
  /// 登録日時
  createdAt          DateTime          @default(now()) @map("created_at")
  /// 更新日時
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([sourceId])
  @@index([walletAddressId, status, createdAt])
  @@index([addressCandidateId, status, createdAt])
  @@map("sync_jobs")
}

/// 監視ウォレットアドレス
model WalletAddress {
  /// ID
  id                           String                        @id @default(cuid())
  /// ウォレットアドレス
  address                      String
  /// 表示名
  displayName                  String?                       @map("display_name")
  /// 監視対象フラグ
  isWatched                    Boolean                       @default(true) @map("is_watched")
  /// 最終同期日時
  lastSyncAt                   DateTime?                     @map("last_sync_at")
  /// データソースID
  sourceId                     String                        @map("source_id")
  source                       DataSource                    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  /// 所有ユーザーID
  ownerUserId                  String?                       @map("owner_user_id")
  ownerUser                    User?                         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  /// 登録日時
  createdAt                    DateTime                      @default(now()) @map("created_at")
  /// 更新日時
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  rawEvents                    RawEvent[]
  normalizedTrades             NormalizedTrade[]
  fundingPayments              FundingPayment[]
  cashFlows                    CashFlow[]
  perpPositions                PerpPosition[]
  perpPositionEvents           PerpPositionEvent[]
  portfolioSnapshots           PortfolioSnapshot[]
  spotBalanceSnapshots         SpotBalanceSnapshot[]
  orderHistory                 OrderHistory[]
  syncCursors                  SyncCursor[]
  syncJobs                     SyncJob[]
  dataQualityIssues            DataQualityIssue[]
  promotedCandidates           AddressCandidate[]            @relation("CandidatePromotion")
  metricCalculationRuns        MetricCalculationRun[]
  dailyNavs                    DailyNav[]
  positionCycles               PositionCycle[]
  performanceMetrics           AddressPerformanceMetric[]
  walletSelectionResults       WalletSelectionResult[]
  walletSelectionOverride      WalletSelectionOverride?
  behaviorNormalizationRuns    BehaviorNormalizationRun[]
  behaviorSelectionScopes      BehaviorSelectionScope[]
  behaviorNormalizationCursors BehaviorNormalizationCursor[]
  selectedWalletBehaviorEvents SelectedWalletBehaviorEvent[]
  behaviorDataQualityIssues    BehaviorDataQualityIssue[]

  @@unique([sourceId, address])
  @@index([isWatched, updatedAt])
  @@index([ownerUserId])
  @@map("wallet_addresses")
}

/// アドレス候補（Candidate）
model AddressCandidate {
  /// ID
  id                   String                        @id @default(cuid())
  /// ウォレットアドレス
  address              String
  /// 初回発見日時
  firstSeenAt          DateTime                      @map("first_seen_at")
  /// 最終発見日時
  lastSeenAt           DateTime                      @map("last_seen_at")
  /// 発見元
  discoverySource      String                        @default("HYPERLIQUID_MARKET_TRADES") @map("discovery_source")
  /// 取引回数
  tradeCount           Int                           @default(0) @map("trade_count")
  /// 推定取引額（USD）
  estimatedNotionalUsd Decimal                       @default(0) @map("estimated_notional_usd") @db.Decimal(38, 18)
  /// Maker回数
  makerCount           Int                           @default(0) @map("maker_count")
  /// Taker回数
  takerCount           Int                           @default(0) @map("taker_count")
  /// 買い回数
  buyCount             Int                           @default(0) @map("buy_count")
  /// 売り回数
  sellCount            Int                           @default(0) @map("sell_count")
  /// ロング関連回数
  longRelatedCount     Int                           @default(0) @map("long_related_count")
  /// ショート関連回数
  shortRelatedCount    Int                           @default(0) @map("short_related_count")
  /// 取引銘柄数
  distinctCoins        Int                           @default(0) @map("distinct_coins")
  /// 最大取引額（USD）
  largestTradeUsd      Decimal                       @default(0) @map("largest_trade_usd") @db.Decimal(38, 18)
  /// 平均取引額（USD）
  averageTradeUsd      Decimal                       @default(0) @map("average_trade_usd") @db.Decimal(38, 18)
  /// 活動日数
  activeDays           Int                           @default(0) @map("active_days")
  /// 活動時間数
  activeHours          Int                           @default(0) @map("active_hours")
  /// Enrichmentステータス
  enrichmentStatus     CandidateEnrichmentStatus     @default(PENDING) @map("enrichment_status")
  /// フィルターステータス
  filterStatus         CandidateFilterStatus         @default(PENDING) @map("filter_status")
  /// 除外理由
  exclusionReasons     String[]                      @default([]) @map("exclusion_reasons")
  /// 昇格日時
  promotedAt           DateTime?                     @map("promoted_at")
  /// 最終Enrichment日時
  lastEnrichedAt       DateTime?                     @map("last_enriched_at")
  /// 次回Enrichment可能日時
  nextEnrichmentAt     DateTime?                     @map("next_enrichment_at")
  /// データ品質スコア
  dataQualityScore     Int                           @default(0) @map("data_quality_score")
  /// 取得可能開始日時
  availableFrom        DateTime?                     @map("available_from")
  /// 取得可能終了日時
  availableTo          DateTime?                     @map("available_to")
  /// 取得Fill件数
  retrievedFillCount   Int                           @default(0) @map("retrieved_fill_count")
  /// 履歴完全性
  historyCompleteness  CandidateHistoryCompleteness  @default(UNKNOWN) @map("history_completeness")
  /// 履歴打切りフラグ
  historyTruncated     Boolean                       @default(false) @map("history_truncated")
  /// 履歴打切り理由
  truncationReason     String?                       @map("truncation_reason")
  /// Enrichmentメタデータ
  enrichmentMetadata   Json?                         @map("enrichment_metadata")
  /// データソースID
  sourceId             String                        @map("source_id")
  source               DataSource                    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  /// 昇格先ウォレットID
  promotedWalletId     String?                       @map("promoted_wallet_id")
  promotedWallet       WalletAddress?                @relation("CandidatePromotion", fields: [promotedWalletId], references: [id], onDelete: SetNull)
  participations       CandidateTradeParticipation[]
  coins                CandidateCoin[]
  activityBuckets      CandidateActivityBucket[]
  enrichmentAttempts   CandidateEnrichmentAttempt[]
  syncJobs             SyncJob[]
  qualityIssues        CandidateDataQualityIssue[]
  /// 登録日時
  createdAt            DateTime                      @default(now()) @map("created_at")
  /// 更新日時
  updatedAt            DateTime                      @updatedAt @map("updated_at")

  @@unique([sourceId, address])
  @@index([filterStatus, enrichmentStatus, lastSeenAt])
  @@index([estimatedNotionalUsd, tradeCount])
  @@map("address_candidates")
}

/// 探索市場取引
model DiscoveryTrade {
  /// ID
  id              String                        @id @default(cuid())
  /// 外部取引ID
  externalTradeId String                        @map("external_trade_id")
  /// フィンガープリント
  fingerprint     String
  /// 銘柄
  coin            String
  /// 売買方向
  side            TradeSide
  /// 価格
  price           Decimal                       @db.Decimal(38, 18)
  /// 数量
  size            Decimal                       @db.Decimal(38, 18)
  /// 取引額（USD）
  notionalUsd     Decimal                       @map("notional_usd") @db.Decimal(38, 18)
  /// 発生日時
  occurredAt      DateTime                      @map("occurred_at")
  /// トランザクションハッシュ
  transactionHash String                        @map("transaction_hash")
  /// 取引ID
  tradeId         String                        @map("trade_id")
  /// 買い手アドレス
  buyerAddress    String                        @map("buyer_address")
  /// 売り手アドレス
  sellerAddress   String                        @map("seller_address")
  /// 生ペイロード
  rawPayload      String                        @map("raw_payload") @db.Text
  /// データソースID
  sourceId        String                        @map("source_id")
  source          DataSource                    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  participations  CandidateTradeParticipation[]
  /// 受信日時
  receivedAt      DateTime                      @default(now()) @map("received_at")

  @@unique([sourceId, externalTradeId])
  @@unique([sourceId, fingerprint])
  @@index([coin, occurredAt])
  @@index([buyerAddress, occurredAt])
  @@index([sellerAddress, occurredAt])
  @@map("discovery_trades")
}

/// 候補取引参加
model CandidateTradeParticipation {
  /// ID
  id               String                 @id @default(cuid())
  /// アドレス候補ID
  candidateId      String                 @map("candidate_id")
  candidate        AddressCandidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// 探索市場取引ID
  discoveryTradeId String                 @map("discovery_trade_id")
  discoveryTrade   DiscoveryTrade         @relation(fields: [discoveryTradeId], references: [id], onDelete: Cascade)
  /// 取引参加役割
  role             CandidateTradeRole
  /// 流動性役割
  liquidityRole    CandidateLiquidityRole @map("liquidity_role")
  /// 売買方向
  side             TradeSide
  /// 登録日時
  createdAt        DateTime               @default(now()) @map("created_at")

  @@unique([candidateId, discoveryTradeId])
  @@index([candidateId, createdAt])
  @@map("candidate_trade_participations")
}

/// 候補対象銘柄
model CandidateCoin {
  /// ID
  id          String           @id @default(cuid())
  /// アドレス候補ID
  candidateId String           @map("candidate_id")
  candidate   AddressCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// 銘柄
  coin        String
  /// 初回発見日時
  firstSeenAt DateTime         @map("first_seen_at")
  /// 最終発見日時
  lastSeenAt  DateTime         @map("last_seen_at")
  /// 取引回数
  tradeCount  Int              @default(1) @map("trade_count")

  @@unique([candidateId, coin])
  @@index([coin, lastSeenAt])
  @@map("candidate_coins")
}

/// 候補活動時間帯
model CandidateActivityBucket {
  /// ID
  id          String                  @id @default(cuid())
  /// アドレス候補ID
  candidateId String                  @map("candidate_id")
  candidate   AddressCandidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// 活動集計単位
  period      CandidateActivityPeriod
  /// 集計期間開始日時
  bucketStart DateTime                @map("bucket_start")

  @@unique([candidateId, period, bucketStart])
  @@index([period, bucketStart])
  @@map("candidate_activity_buckets")
}

/// 候補詳細取得試行（Enrichment）
model CandidateEnrichmentAttempt {
  /// ID
  id                  String                       @id @default(cuid())
  /// アドレス候補ID
  candidateId         String                       @map("candidate_id")
  candidate           AddressCandidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// 要求開始日時
  requestedFrom       DateTime                     @map("requested_from")
  /// 要求終了日時
  requestedTo         DateTime                     @map("requested_to")
  /// 取得可能開始日時
  availableFrom       DateTime?                    @map("available_from")
  /// 取得可能終了日時
  availableTo         DateTime?                    @map("available_to")
  /// 取得Fill件数
  retrievedFillCount  Int                          @default(0) @map("retrieved_fill_count")
  /// 履歴完全性
  historyCompleteness CandidateHistoryCompleteness @default(UNKNOWN) @map("history_completeness")
  /// 履歴打切りフラグ
  historyTruncated    Boolean                      @default(false) @map("history_truncated")
  /// 履歴打切り理由
  truncationReason    String?                      @map("truncation_reason")
  /// エンドポイント結果
  endpointResults     Json?                        @map("endpoint_results")
  /// エラーメッセージ
  errorMessage        String?                      @map("error_message") @db.Text
  /// 開始日時
  startedAt           DateTime                     @default(now()) @map("started_at")
  /// 終了日時
  finishedAt          DateTime?                    @map("finished_at")
  /// 成功フラグ
  succeeded           Boolean                      @default(false)

  @@index([candidateId, startedAt])
  @@map("candidate_enrichment_attempts")
}

/// 候補データ品質問題（Data Quality）
model CandidateDataQualityIssue {
  /// ID
  id              String                 @id @default(cuid())
  /// フィンガープリント
  fingerprint     String                 @unique
  /// 問題種別
  issueType       String                 @map("issue_type")
  /// 重要度
  severity        AlertSeverity
  /// ステータス
  status          DataQualityIssueStatus @default(OPEN)
  /// メッセージ
  message         String                 @db.Text
  /// 詳細
  details         Json?
  /// アドレス候補ID
  candidateId     String                 @map("candidate_id")
  candidate       AddressCandidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// 初回検知日時
  firstDetectedAt DateTime               @default(now()) @map("first_detected_at")
  /// 最終検知日時
  lastDetectedAt  DateTime               @default(now()) @map("last_detected_at")
  /// 解消日時
  resolvedAt      DateTime?              @map("resolved_at")
  /// 登録日時
  createdAt       DateTime               @default(now()) @map("created_at")
  /// 更新日時
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@index([candidateId, status, severity])
  @@map("candidate_data_quality_issues")
}

/// アドレス探索設定
model DiscoverySettings {
  /// ID
  id                           String        @id @default(cuid())
  /// データソースID
  sourceId                     String        @unique @map("source_id")
  source                       DataSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// 有効フラグ
  enabled                      Boolean       @default(false)
  /// 探索モード
  mode                         DiscoveryMode @default(MAJOR)
  /// 優先購読銘柄
  priorityCoins                String[]      @default(["BTC", "ETH", "SOL", "HYPE", "SUI"]) @map("priority_coins")
  /// 最小観測取引回数
  minimumObservedTradeCount    Int           @default(10) @map("minimum_observed_trade_count")
  /// 最小観測取引額（USD）
  minimumObservedNotionalUsd   Decimal       @default(10000) @map("minimum_observed_notional_usd") @db.Decimal(38, 18)
  /// 直近活動判定時間数
  recentActivityHours          Int           @default(24) @map("recent_activity_hours")
  /// 詳細評価最小取引回数
  fullMinimumTradeCount        Int           @default(30) @map("full_minimum_trade_count")
  /// 詳細評価最小活動日数
  fullMinimumActiveDays        Int           @default(180) @map("full_minimum_active_days")
  /// 詳細評価最小活動月数
  fullMinimumActiveMonths      Int           @default(6) @map("full_minimum_active_months")
  /// 詳細評価最小取引額（USD）
  fullMinimumNotionalUsd       Decimal       @default(10000) @map("full_minimum_notional_usd") @db.Decimal(38, 18)
  /// 詳細評価直近活動日数
