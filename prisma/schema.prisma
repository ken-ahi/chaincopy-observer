model MetricCalculationRun {
  id                  String                         @id @default(cuid())
  walletAddressId     String                         @map("wallet_address_id")
  walletAddress       WalletAddress                  @relation(fields: [walletAddressId], references: [id], onDelete: Cascade)
  calculationVersion  String                         @map("calculation_version")
  calculationFrom     DateTime                       @map("calculation_from")
  calculationTo       DateTime                       @map("calculation_to")
  requestedAt         DateTime                       @map("requested_at")
  requestedBy         String                         @map("requested_by")
  startedAt           DateTime?                      @map("started_at")
  completedAt         DateTime?                      @map("completed_at")
  status              MetricCalculationStatus        @default(PENDING)
  historyCompleteness PerformanceHistoryCompleteness @map("history_completeness")
  precision           PerformancePrecision?
  inputFingerprint    String                         @map("input_fingerprint")
  deduplicationKey    String                         @unique(map: "metric_runs_dedup_key") @map("deduplication_key")
  warningCount        Int                            @default(0) @map("warning_count")
  warningCodes        String[]                       @default([]) @map("warning_codes")
  errorCode           String?                        @map("error_code")
  errorMessage        String?                        @map("error_message") @db.Text
  dailyNavs           DailyNav[]
  positionCycles      PositionCycle[]
  performanceMetrics  AddressPerformanceMetric[]
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")

  @@index([walletAddressId, status, requestedAt], map: "metric_runs_wallet_status_requested_idx")
  @@index([walletAddressId, calculationVersion, inputFingerprint], map: "metric_runs_input_idx")
  @@map("metric_calculation_runs")
}

model DailyNav {
  id                  String                         @id @default(cuid())
  walletAddressId     String                         @map("wallet_address_id")
  walletAddress       WalletAddress                  @relation(fields: [walletAddressId], references: [id], onDelete: Cascade)
  calculationRunId    String                         @map("calculation_run_id")
  calculationRun      MetricCalculationRun           @relation(fields: [calculationRunId], references: [id], onDelete: Cascade)
  date                DateTime                       @db.Date
  nav                 Decimal                        @db.Decimal(38, 18)
  cashBalance         Decimal?                       @map("cash_balance") @db.Decimal(38, 18)
  unrealizedPnl       Decimal?                       @map("unrealized_pnl") @db.Decimal(38, 18)
  realizedPnl         Decimal?                       @map("realized_pnl") @db.Decimal(38, 18)
  funding             Decimal?                       @db.Decimal(38, 18)
  fees                Decimal?                       @db.Decimal(38, 18)
  externalCashFlow    Decimal?                       @map("external_cash_flow") @db.Decimal(38, 18)
  precision           PerformancePrecision
  historyCompleteness PerformanceHistoryCompleteness @map("history_completeness")
  createdAt           DateTime                       @default(now()) @map("created_at")

  @@unique([calculationRunId, date], map: "daily_navs_run_date_key")
  @@index([walletAddressId, date], map: "daily_navs_wallet_date_idx")
  @@map("daily_navs")
}

model PositionCycle {
  id                String               @id @default(cuid())
  walletAddressId   String               @map("wallet_address_id")
  walletAddress     WalletAddress        @relation(fields: [walletAddressId], references: [id], onDelete: Cascade)
  calculationRunId  String               @map("calculation_run_id")
  calculationRun    MetricCalculationRun @relation(fields: [calculationRunId], references: [id], onDelete: Cascade)
  coin              String
  side              PositionSide
  openedAt          DateTime             @map("opened_at")
  closedAt          DateTime?            @map("closed_at")
  averageEntryPrice Decimal              @map("average_entry_price") @db.Decimal(38, 18)
  averageExitPrice  Decimal?             @map("average_exit_price") @db.Decimal(38, 18)
  entryQuantity     Decimal              @map("entry_quantity") @db.Decimal(38, 18)
  exitQuantity      Decimal              @map("exit_quantity") @db.Decimal(38, 18)
  grossRealizedPnl  Decimal              @map("gross_realized_pnl") @db.Decimal(38, 18)
  fees              Decimal              @db.Decimal(38, 18)
  funding           Decimal              @db.Decimal(38, 18)
  netRealizedPnl    Decimal              @map("net_realized_pnl") @db.Decimal(38, 18)
  fillCount         Int                  @map("fill_count")
  status            PositionCycleStatus
  inputFingerprint  String               @map("input_fingerprint")
  createdAt         DateTime             @default(now()) @map("created_at")

  @@unique([calculationRunId, inputFingerprint], map: "position_cycles_run_input_key")
  @@index([walletAddressId, openedAt], map: "position_cycles_wallet_opened_idx")
  @@map("position_cycles")
}

model AddressPerformanceMetric {
  id               String                  @id @default(cuid())
  walletAddressId  String                  @map("wallet_address_id")
  walletAddress    WalletAddress           @relation(fields: [walletAddressId], references: [id], onDelete: Cascade)
  calculationRunId String                  @map("calculation_run_id")
  calculationRun   MetricCalculationRun    @relation(fields: [calculationRunId], references: [id], onDelete: Cascade)
  metricKey        String                  @map("metric_key")
  metricValue      Decimal                 @map("metric_value") @db.Decimal(38, 18)
  precision        PerformancePrecision
  status           PerformanceMetricStatus
  warningCodes     String[]                @default([]) @map("warning_codes")
  calculationFrom  DateTime                @map("calculation_from")
  calculationTo    DateTime                @map("calculation_to")
  metricVersion    String                  @map("metric_version")
  createdAt        DateTime                @default(now()) @map("created_at")

  @@unique([calculationRunId, metricKey], map: "performance_metrics_run_key")
  @@index([walletAddressId, metricKey, calculationTo], map: "performance_metrics_wallet_key_to_idx")
  @@map("address_performance_metrics")
}

model SystemAlert {
  id          String        @id @default(cuid())
  fingerprint String        @unique
  severity    AlertSeverity
  status      AlertStatus   @default(OPEN)
  title       String
  message     String        @db.Text
  sourceId    String?       @map("source_id")
  source      DataSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  openedAt    DateTime      @default(now()) @map("opened_at")
  resolvedAt  DateTime?     @map("resolved_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status, severity])
  @@index([sourceId])
  @@map("system_alerts")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?  @map("actor_user_id")
