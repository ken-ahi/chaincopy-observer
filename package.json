{
  "name": "chaincopy-observer",
  "version": "0.2.0",
  "private": true,
  "description": "Single-user analytics and monitoring foundation for public Hyperliquid and Sui/Cetus data.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "deploy:local": "sh scripts/deploy-local.sh"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.2.11",
    "@playwright/test": "1.62.0",
    "@prisma/client": "6.19.3",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "turbo": "2.10.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
